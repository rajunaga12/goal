<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>My Daily Dashboard</title>
<style>
:root{--bg:#f3f6f4;--card:#fff;--ink:#16231d;--mute:#5d6f66;--line:#d9e2dc;--accent:#0f766e;--accent2:#e8f3f1;--warn:#b45309;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1714;--card:#17221d;--ink:#e6efe9;--mute:#98aaa0;--line:#2a3a32;--accent:#2dd4bf;--accent2:#12312c;--warn:#f59e0b;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0f1714;--card:#17221d;--ink:#e6efe9;--mute:#98aaa0;--line:#2a3a32;--accent:#2dd4bf;--accent2:#12312c;--warn:#f59e0b;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;line-height:1.5}
main{max-width:980px;margin:0 auto;padding:20px 16px 60px}
header{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:18px}
h1{font-size:1.7rem;margin:0}
.date{color:var(--mute);font-size:.95rem}
nav{display:flex;gap:6px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:5px;margin-bottom:18px}
nav button{flex:1;border:0;background:none;color:var(--mute);padding:10px;border-radius:8px;font:inherit;font-weight:600;cursor:pointer}
nav button[aria-selected="true"]{background:var(--accent);color:#fff}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
section{display:none}section.on{display:block}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:14px}
.row{display:flex;gap:8px;flex-wrap:wrap}
input,select{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:9px 11px;min-width:0}
input.grow{flex:1 1 160px}
.btn{font:inherit;font-weight:600;background:var(--accent);color:#fff;border:0;border-radius:8px;padding:9px 16px;cursor:pointer}
.ghost{background:none;color:var(--mute);border:0;cursor:pointer;font:inherit;padding:4px 8px}
.ghost:hover{color:var(--warn)}
ul{list-style:none;margin:12px 0 0;padding:0}
li{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--line)}
li span.t{flex:1;overflow-wrap:anywhere}
li.done span.t{text-decoration:line-through;color:var(--mute)}
input[type=checkbox]{width:20px;height:20px;accent-color:var(--accent)}
.bar{height:10px;background:var(--accent2);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent);border-radius:99px;transition:width .3s}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}
.stat b{display:block;font-size:1.5rem}
.stat small{color:var(--mute)}
.in{color:var(--accent);font-weight:700}.out{color:var(--warn);font-weight:700}
h2{font-size:1.1rem;margin:0 0 10px}
.mute{color:var(--mute);font-size:.9rem}
.empty{color:var(--mute);padding:14px 0 4px}
.skill{padding:12px 0;border-top:1px solid var(--line)}
.skill .top{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:6px}
</style>
</head>
<body>
<main>
<header>
  <div><h1>My Daily Dashboard</h1><div class="date" id="date"></div></div>
  <div class="mute" id="streak"></div>
</header>

<nav role="tablist" aria-label="Sections">
  <button role="tab" data-tab="tasks" aria-selected="true">Tasks</button>
  <button role="tab" data-tab="money" aria-selected="false">Money</button>
  <button role="tab" data-tab="skills" aria-selected="false">Skills</button>
</nav>

<section id="tasks" class="on">
  <div class="stats">
    <div class="stat"><b id="tDone">0/0</b><small>done today</small></div>
    <div class="stat"><b id="tPct">0%</b><small>progress</small></div>
  </div>
  <div class="card">
    <div class="bar"><i id="tBar" style="width:0"></i></div>
    <div class="row" style="margin-top:14px">
      <input class="grow" id="tIn" placeholder="What do you need to do today?" aria-label="New task">
      <button class="btn" id="tAdd">Add task</button>
    </div>
    <ul id="tList"></ul>
    <button class="ghost" id="tClear">Clear finished tasks</button>
  </div>
</section>

<section id="money">
  <div class="stats">
    <div class="stat"><b id="mBal">₹0</b><small>saved so far</small></div>
    <div class="stat"><b id="mIn" class="in">₹0</b><small>added this month</small></div>
    <div class="stat"><b id="mOut" class="out">₹0</b><small>spent this month</small></div>
  </div>
  <div class="card">
    <h2>Savings goal</h2>
    <div class="row">
      <input class="grow" id="gName" placeholder="Goal (e.g. Laptop)" aria-label="Goal name">
      <input id="gAmt" type="number" min="0" placeholder="Target ₹" aria-label="Goal amount" style="width:130px">
      <button class="btn" id="gSet">Set goal</button>
    </div>
    <div id="gView" style="margin-top:12px"></div>
  </div>
  <div class="card">
    <h2>Add money entry</h2>
    <div class="row">
      <select id="mType" aria-label="Type"><option value="in">Saved</option><option value="out">Spent</option></select>
      <input id="mAmt" type="number" min="0" placeholder="Amount ₹" aria-label="Amount" style="width:130px">
      <input class="grow" id="mNote" placeholder="Note (e.g. Pocket money, Books)" aria-label="Note">
      <button class="btn" id="mAdd">Add</button>
    </div>
    <ul id="mList"></ul>
  </div>
</section>

<section id="skills">
  <div class="card">
    <h2>Add a skill to learn</h2>
    <div class="row">
      <input class="grow" id="sName" placeholder="Skill (e.g. React, DSA, AWS)" aria-label="Skill name">
      <input id="sGoal" type="number" min="1" placeholder="Goal hours" aria-label="Goal hours" style="width:130px">
      <button class="btn" id="sAdd">Add skill</button>
    </div>
  </div>
  <div class="card"><div id="sList"></div></div>
</section>
</main>

<script>
var K="dash-v1",S={tasks:[],money:[],goal:null,skills:[],days:[]};
try{var raw=localStorage.getItem(K);if(raw)S=Object.assign(S,JSON.parse(raw))}catch(e){}
function save(){try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}}
var $=function(i){return document.getElementById(i)};
var uid=function(){return Date.now()+Math.random()};
var inr=function(n){return "₹"+Number(n).toLocaleString("en-IN")};
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
var today=new Date().toISOString().slice(0,10);
$("date").textContent=new Date().toLocaleDateString("en-IN",{weekday:"long",day:"numeric",month:"long",year:"numeric"});

document.querySelectorAll("nav button").forEach(function(b){b.onclick=function(){
  document.querySelectorAll("nav button").forEach(function(x){x.setAttribute("aria-selected",x===b)});
  document.querySelectorAll("section").forEach(function(s){s.classList.toggle("on",s.id===b.dataset.tab)});
}});

/* Tasks */
function markDay(){if(S.days.indexOf(today)<0){S.days.push(today)}}
function streak(){var n=0,d=new Date();for(;;){var k=d.toISOString().slice(0,10);if(S.days.indexOf(k)>=0){n++;d.setDate(d.getDate()-1)}else if(n===0&&k===today){d.setDate(d.getDate()-1)}else break}return n}
function rTasks(){
  var t=S.tasks,d=t.filter(function(x){return x.done}).length,p=t.length?Math.round(d/t.length*100):0;
  $("tDone").textContent=d+"/"+t.length;$("tPct").textContent=p+"%";$("tBar").style.width=p+"%";
  $("tList").innerHTML=t.length?t.map(function(x){return '<li class="'+(x.done?"done":"")+'"><input type="checkbox" data-t="'+x.id+'" '+(x.done?"checked":"")+' aria-label="Done"><span class="t">'+esc(x.text)+'</span><button class="ghost" data-dt="'+x.id+'" aria-label="Delete task">✕</button></li>'}).join(""):'<div class="empty">No tasks yet. Add your first one above.</div>';
  var s=streak();$("streak").textContent=s?s+"-day streak":"Finish a task to start a streak";
}
$("tAdd").onclick=function(){var v=$("tIn").value.trim();if(!v)return;S.tasks.push({id:uid(),text:v,done:false});$("tIn").value="";save();rTasks()};
$("tIn").onkeydown=function(e){if(e.key==="Enter")$("tAdd").click()};
$("tList").onclick=function(e){var a=e.target.dataset;
  if(a.t){S.tasks.forEach(function(x){if(String(x.id)===a.t){x.done=e.target.checked;if(x.done)markDay()}});save();rTasks()}
  if(a.dt){S.tasks=S.tasks.filter(function(x){return String(x.id)!==a.dt});save();rTasks()}};
$("tClear").onclick=function(){S.tasks=S.tasks.filter(function(x){return !x.done});save();rTasks()};

/* Money */
function rMoney(){
  var bal=0,mi=0,mo=0,ym=today.slice(0,7);
  S.money.forEach(function(x){var v=x.type==="in"?x.amt:-x.amt;bal+=v;if(x.date.slice(0,7)===ym){x.type==="in"?mi+=x.amt:mo+=x.amt}});
  $("mBal").textContent=inr(bal);$("mIn").textContent=inr(mi);$("mOut").textContent=inr(mo);
  var g=S.goal;
  $("gView").innerHTML=g?'<div class="top row" style="justify-content:space-between"><b>'+esc(g.name)+'</b><span class="mute">'+inr(Math.max(bal,0))+" of "+inr(g.amt)+'</span></div><div class="bar" style="margin-top:6px"><i style="width:'+Math.min(100,Math.max(0,bal/g.amt*100))+'%"></i></div><div class="mute" style="margin-top:6px">'+(bal>=g.amt?"Goal reached!":inr(g.amt-bal)+" to go")+'</div>':'<div class="mute">No goal yet. Set one to track progress.</div>';
  var m=S.money.slice().reverse();
  $("mList").innerHTML=m.length?m.map(function(x){return '<li><span class="t">'+esc(x.note||(x.type==="in"?"Saved":"Spent"))+'<br><small class="mute">'+x.date+'</small></span><span class="'+x.type+'">'+(x.type==="in"?"+":"−")+inr(x.amt)+'</span><button class="ghost" data-dm="'+x.id+'" aria-label="Delete entry">✕</button></li>'}).join(""):'<div class="empty">No entries yet.</div>';
}
$("mAdd").onclick=function(){var a=parseFloat($("mAmt").value);if(!(a>0))return;S.money.push({id:uid(),type:$("mType").value,amt:a,note:$("mNote").value.trim(),date:today});$("mAmt").value="";$("mNote").value="";save();rMoney()};
$("mList").onclick=function(e){var id=e.target.dataset.dm;if(id){S.money=S.money.filter(function(x){return String(x.id)!==id});save();rMoney()}};
$("gSet").onclick=function(){var n=$("gName").value.trim(),a=parseFloat($("gAmt").value);if(!n||!(a>0))return;S.goal={name:n,amt:a};$("gName").value="";$("gAmt").value="";save();rMoney()};

/* Skills */
function rSkills(){
  $("sList").innerHTML=S.skills.length?S.skills.map(function(s){var p=Math.min(100,Math.round(s.done/s.goal*100));
    return '<div class="skill"><div class="top"><b>'+esc(s.name)+'</b><span class="mute">'+s.done+"/"+s.goal+' hrs · '+p+'%</span></div><div class="bar"><i style="width:'+p+'%"></i></div><div class="row" style="margin-top:8px"><button class="btn" data-h="'+s.id+'" data-v="0.5">+30 min</button><button class="btn" data-h="'+s.id+'" data-v="1">+1 hr</button><button class="ghost" data-ds="'+s.id+'">Remove</button></div></div>'}).join(""):'<div class="empty">No skills yet. Add what you are learning, like React or DSA.</div>';
}
$("sAdd").onclick=function(){var n=$("sName").value.trim(),g=parseFloat($("sGoal").value)||50;if(!n)return;S.skills.push({id:uid(),name:n,goal:g,done:0});$("sName").value="";$("sGoal").value="";save();rSkills()};
$("sList").onclick=function(e){var a=e.target.dataset;
  if(a.h){S.skills.forEach(function(s){if(String(s.id)===a.h)s.done=Math.round((s.done+parseFloat(a.v))*10)/10});markDay();save();rSkills();rTasks()}
  if(a.ds){S.skills=S.skills.filter(function(s){return String(s.id)!==a.ds});save();rSkills()}};

rTasks();rMoney();rSkills();
</script>
</body>
</html>
